{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shizuku Pet",
  "version": "0.1.0",
  "identifier": "dev.shizuku.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "雨宮 雫",
        "width": 420,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "noRedirectionBitmap": true,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/actions/*/action-*/frame_*.png"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "雨宮 雫的桌面寵物",
    "copyright": "shizuku-pet contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
